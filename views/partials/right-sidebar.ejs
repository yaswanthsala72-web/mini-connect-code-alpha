<aside class="right-sidebar">
  <div class="search-widget glass-panel">
    <div class="search-input-wrapper">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
      <input type="text" id="user-search-field" class="search-field" placeholder="Search creators..." autocomplete="off">
    </div>
    <div id="search-dropdown-results" class="search-results-panel glass-panel glow-cyan"></div>
  </div>

  <div class="widget-card glass-panel">
    <div class="widget-title">
      <span>Creators to Follow</span>
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" width="18" height="18" style="color: var(--neon-cyan);">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
      </svg>
    </div>
    <div class="widget-list">
      <% const suggestions = typeof friendSuggestions !== 'undefined' ? friendSuggestions : []; %>
      <% if (suggestions.length === 0) { %>
        <p style="padding:10px;color:var(--text-muted);font-size:0.8rem;">No new suggestions right now.</p>
      <% } %>
      <% suggestions.forEach(s => { %>
        <div class="follow-item">
          <a href="/users/<%= s.username %>" class="follow-user-link">
            <img class="follow-avatar" src="<%= s.profilePicture %>" alt="<%= s.username %>">
            <div class="follow-meta">
              <h5><%= s.username %></h5>
              <p><%= s.bio.length > 40 ? s.bio.slice(0, 40) + '...' : s.bio %></p>
            </div>
          </a>
          <button class="btn-primary sidebar-follow-btn" data-user-id="<%= s._id %>" style="padding: 6px 12px; font-size: 0.75rem; border-radius: 8px;">Follow</button>
        </div>
      <% }) %>
    </div>
  </div>
</aside>
