<aside class="left-sidebar">
  <div class="sidebar-profile glass-panel glow-purple">
    <div class="profile-avatar-wrapper">
      <div class="avatar-ring">
        <img src="<%= user.profilePicture %>" alt="<%= user.username %>">
      </div>
    </div>
    <h3><%= user.username %></h3>
    <p style="margin-top: 5px; font-size: 0.75rem; color: var(--text-muted);">@<%= user.username %></p>
    <p style="margin-top: 10px;" class="sidebar-bio-text"><%= user.bio %></p>
  </div>

  <nav class="glass-panel sidebar-nav">
    <a href="/" class="menu-item <%= activePath === '/' ? 'active' : '' %>">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" /></svg>
      <span>Home Feed</span>
    </a>
    <a href="/posts/create" class="menu-item <%= activePath === '/posts/create' ? 'active' : '' %>">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v3m0 0v3m0-3h3m-3 0H9m12 0a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
      <span>Create Post</span>
    </a>
    <a href="/search" class="menu-item <%= activePath.startsWith('/search') ? 'active' : '' %>">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
      <span>Search</span>
    </a>
    <a href="/saved-posts" class="menu-item <%= activePath === '/saved-posts' ? 'active' : '' %>">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z" /></svg>
      <span>Saved Posts</span>
    </a>
    <a href="/notifications" class="menu-item <%= activePath.startsWith('/notifications') ? 'active' : '' %>">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" /></svg>
      <span>Notifications</span>
      <% if (typeof unreadNotifications !== 'undefined' && unreadNotifications > 0) { %>
        <span class="menu-badge"><%= unreadNotifications %></span>
      <% } %>
    </a>
    <a href="/dashboard" class="menu-item <%= activePath.startsWith('/dashboard') ? 'active' : '' %>">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" /></svg>
      <span>Dashboard</span>
    </a>
    <a href="/chat" class="menu-item <%= activePath.startsWith('/chat') ? 'active' : '' %>">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" /></svg>
      <span>Messages</span>
      <% if (typeof unreadMessages !== 'undefined' && unreadMessages > 0) { %>
        <span class="menu-badge"><%= unreadMessages %></span>
      <% } %>
    </a>
    <a href="/users/<%= user.username %>" class="menu-item <%= activePath === `/users/${user.username}` ? 'active' : '' %>">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
      <span>My Profile</span>
    </a>
    <hr style="border: 0; border-top: 1px solid var(--glass-border); margin: 10px 0;">
    <a href="/auth/logout" class="menu-item" style="color: var(--neon-pink);">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" style="color: var(--neon-pink);"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" /></svg>
      <span>Logout</span>
    </a>
  </nav>
</aside>
