  <!-- Mobile Bottom Floating Navigation Bar -->
  <% if (user) { %>
    <nav class="mobile-bottom-nav">
      <a href="/" class="mobile-nav-item <%= activePath === '/' ? 'active' : '' %>" title="Feed">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
        </svg>
      </a>
      <a href="/posts/create" class="mobile-nav-item <%= activePath === '/posts/create' ? 'active' : '' %>" title="Create Post">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v3m0 0v3m0-3h3m-3 0H9m12 0a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      </a>
      <!-- Alerts trigger button on mobile -->
      <a href="#" onclick="event.preventDefault(); const p = document.getElementById('draggable-panel'); p.style.display = p.style.display === 'flex' ? 'none' : 'flex'" class="mobile-nav-item" title="Alerts">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
        </svg>
      </a>
      <a href="/users/<%= user.username %>" class="mobile-nav-item <%= activePath === `/users/${user.username}` ? 'active' : '' %>" title="Profile">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
        </svg>
      </a>
    </nav>
  <% } %>

  <!-- Premium Draggable Floating Alerts Center (Notification Panel) -->
  <% if (user) { %>
    <div id="draggable-panel" class="draggable-panel glass-panel glow-purple" style="display: none;">
      <div class="draggable-header">
        <div class="draggable-title">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" width="18" height="18" style="color: var(--neon-cyan);">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
          </svg>
          <span>Neon Notifications</span>
          <span class="draggable-badge" id="dropdown-notif-badge"><%= typeof unreadNotifications !== 'undefined' ? unreadNotifications : 0 %></span>
        </div>
        <a href="/notifications" class="action-btn" style="padding: 4px 10px; font-size: 0.7rem; text-decoration: none; margin-right: 8px;">View All</a>
        <button class="draggable-close-btn" title="Dismiss Panel">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" width="18" height="18">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
      
      <div class="draggable-content" id="notification-dropdown-content">
        <div style="padding: 20px; text-align: center; color: var(--text-muted);">Loading...</div>
      </div>
    </div>
  <% } %>

  <!-- Premium Instagram-Inspired Fullscreen Story Viewer Overlay -->
  <div id="story-viewer-modal" class="story-viewer-overlay">
    <div class="story-viewer-card glass-panel glow-cyan">
      
      <!-- Top Autoplay Progress Timeline bar -->
      <div class="story-progress-bar-row">
        <div class="story-progress-bar-bg">
          <div class="story-progress-bar-fill"></div>
        </div>
      </div>

      <!-- User metadata header -->
      <div class="story-viewer-header">
        <a href="#" class="story-viewer-user">
          <img class="story-viewer-avatar" src="" alt="avatar">
          <span class="story-viewer-username">creator</span>
        </a>
        <button class="draggable-close-btn" style="color: white; filter: drop-shadow(0 2px 4px rgba(0,0,0,0.5));" title="Close Stories">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" width="22" height="22">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <!-- Main story display media container -->
      <div class="story-viewer-media">
        <img class="story-viewer-image" src="" alt="story media">
        <div class="story-viewer-caption">Caption text here...</div>
      </div>

    </div>
  </div>

  <!-- Master Interactive JS Asset -->
  <script src="/js/main.js"></script>

</body>
</html>
