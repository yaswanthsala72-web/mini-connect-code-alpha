<% const isOwner = post.author._id.toString() === currentUser.id; %>
<% const userLiked = post.likes.map(String).includes(currentUser.id); %>
<% const isSaved = typeof savedPostIds !== 'undefined' && savedPostIds.includes(post._id.toString()); %>
<% const commentsCount = post.comments ? post.comments.length : 0; %>
<% const viewsCount = post.views || 0; %>

<article class="post-card glass-panel" id="post-<%= post._id %>" data-post-id="<%= post._id %>">
  <div class="post-header">
    <a href="/users/<%= post.author.username %>" class="post-author-info">
      <img class="post-author-avatar" src="<%= post.author.profilePicture %>" alt="<%= post.author.username %>">
      <div class="post-author-meta">
        <h4><%= post.author.username %></h4>
        <span><%= new Date(post.createdAt).toLocaleDateString(undefined, { month: 'short', day: 'numeric', hour: '2-digit', minute:'2-digit' }) %></span>
      </div>
    </a>
    <% if (isOwner) { %>
      <div class="post-header-actions">
        <a href="/post/edit/<%= post._id %>" class="post-action-icon" title="Edit Post">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" width="18" height="18">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
          </svg>
        </a>
        <button class="post-action-icon delete-post-btn" data-post-id="<%= post._id %>" title="Delete Post">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" width="18" height="18">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
          </svg>
        </button>
      </div>
    <% } %>
  </div>

  <% if (post.content) { %>
    <div class="post-content"><p><%= post.content %></p></div>
  <% } %>

  <% if (post.image) { %>
    <div class="post-image-wrapper"><img src="<%= post.image %>" alt="Post attachment"></div>
  <% } %>

  <div class="post-stats">
    <span class="stat-likes">❤️ <span class="likes-count-num"><%= post.likes.length %></span> Likes</span>
    <span class="stat-comments">💬 <span class="comments-count-num"><%= commentsCount %></span> Comments</span>
    <span class="stat-views">👁 <span class="views-count-num"><%= viewsCount %></span> Views</span>
  </div>

  <div class="post-actions-bar">
    <button class="post-interaction-btn like-btn <%= userLiked ? 'liked' : '' %>" data-post-id="<%= post._id %>">
      <svg xmlns="http://www.w3.org/2000/svg" fill="<%= userLiked ? 'currentColor' : 'none' %>" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
      </svg>
      <span>Like</span>
    </button>
    <button class="post-interaction-btn" onclick="this.closest('.post-card').querySelector('.comment-composer-input').focus()">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
      </svg>
      <span>Comment</span>
    </button>
    <button class="post-interaction-btn bookmark-btn <%= isSaved ? 'saved' : '' %>" data-post-id="<%= post._id %>">
      <svg xmlns="http://www.w3.org/2000/svg" fill="<%= isSaved ? 'currentColor' : 'none' %>" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z" />
      </svg>
      <span><%= isSaved ? 'Saved' : 'Save' %></span>
    </button>
  </div>

  <div class="comments-section">
    <div class="comments-list">
      <% if (!post.comments || post.comments.length === 0) { %>
        <div class="no-comments-msg" style="padding: 10px 0; color: var(--text-muted); font-size: 0.8rem;">No comments yet. Start the conversation!</div>
      <% } else { %>
        <% post.comments.forEach(comment => { %>
          <div class="comment-item">
            <img class="comment-avatar" src="<%= comment.author.profilePicture %>" alt="<%= comment.author.username %>">
            <div class="comment-body">
              <a href="/users/<%= comment.author.username %>" class="comment-user"><%= comment.author.username %></a>
              <span class="comment-text"><%= comment.content %></span>
            </div>
          </div>
        <% }) %>
      <% } %>
    </div>
    <form class="comment-form" data-post-id="<%= post._id %>">
      <div class="comment-composer">
        <input type="text" class="comment-composer-input" placeholder="Add a comment..." required>
        <button type="submit" class="btn-primary" style="padding: 6px 12px; font-size: 0.75rem; border-radius: 8px;">Post</button>
      </div>
    </form>
  </div>
</article>
