<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : '404 - Not Found - MiniConnect' %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body style="display: flex; justify-content: center; align-items: center; min-height: 100vh;">

  <div class="auth-card glass-panel glow-purple" style="text-align: center; max-width: 460px; padding: 40px; display: flex; flex-direction: column; gap: 20px;">
    
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" width="64" height="64" style="color: var(--neon-pink); filter: drop-shadow(0 0 8px var(--neon-pink)); margin: 0 auto;">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
    </svg>

    <h1 style="font-size: 3rem; font-weight: 800; background: linear-gradient(45deg, var(--neon-pink), var(--neon-purple)); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">404</h1>
    
    <h3 style="font-weight: 700;">Lost in Cosmic Space</h3>
    
    <p style="color: var(--text-secondary); font-size: 0.9rem; line-height: 1.5;">The dimensional coordinates you requested do not exist in this digital universe. You may have typed an incorrect URL, or the post was deleted.</p>

    <a href="/" class="btn-primary" style="margin-top: 15px; text-decoration: none; padding: 12px 24px;">
      <span>Return to Safe Orbit</span>
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" width="18" height="18">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
      </svg>
    </a>

  </div>

</body>
</html>
