<%- include('partials/header') %>
<div class="profile-container" style="max-width: 640px; margin: 0 auto;">
  <a href="/" class="action-btn" style="text-decoration: none; padding: 8px 15px; display: inline-flex; align-items: center; gap: 8px; margin-bottom: 20px;">← Back to Feed</a>
  <div class="glass-panel glow-cyan" style="padding: 30px;">
    <h2 style="font-weight: 800; margin-bottom: 20px;">Edit Post</h2>
    <% if (typeof error !== 'undefined' && error) { %><div class="auth-error" style="margin-bottom: 15px;"><%= error %></div><% } %>
    <form action="/post/edit/<%= post._id %>" method="POST" enctype="multipart/form-data" class="auth-form">
      <div class="form-group">
        <label>CAPTION</label>
        <textarea name="content" class="form-control" style="min-height: 120px;"><%= post.content || '' %></textarea>
      </div>
      <% if (post.image) { %>
        <div class="form-group">
          <label>Current Image</label>
          <img src="<%= post.image %>" alt="Current" style="width: 100%; max-height: 200px; object-fit: cover; border-radius: 12px;">
        </div>
      <% } %>
      <div class="form-group">
        <label>Replace Image (optional)</label>
        <input type="file" name="image" accept="image/*" class="form-control">
      </div>
      <button type="submit" class="btn-primary" style="width: 100%; padding: 12px;">Save Changes</button>
    </form>
  </div>
</div>
<%- include('partials/footer') %>
