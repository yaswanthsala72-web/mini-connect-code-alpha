<%- include('partials/header') %>
<div class="app-container">
  <%- include('partials/sidebar') %>
  <main class="main-feed">
    <div class="glass-panel" style="padding: 20px; margin-bottom: 24px; display: flex; justify-content: space-between; align-items: center;">
      <div>
        <h1 style="font-weight: 800; font-size: 1.4rem;">Notifications</h1>
        <p style="color: var(--text-secondary); font-size: 0.85rem;">Stay updated on your universe</p>
      </div>
      <button id="mark-all-read-btn" class="btn-primary" style="padding: 8px 16px; font-size: 0.8rem;">Mark all read</button>
    </div>
    <div style="display: flex; flex-direction: column; gap: 12px;">
      <% if (notifications.length === 0) { %>
        <div class="glass-panel" style="padding: 50px; text-align: center;">
          <p style="color: var(--text-secondary);">No notifications yet.</p>
        </div>
      <% } %>
      <% notifications.forEach(n => { %>
        <div class="notification-card <%= n.type %> <%= n.read ? '' : 'unread' %>" data-notification-id="<%= n._id %>">
          <img class="notification-avatar" src="<%= n.sender.profilePicture %>" alt="">
          <div class="notification-text-meta">
            <h6><%= n.message %></h6>
            <p><%= new Date(n.createdAt).toLocaleString() %></p>
          </div>
          <% if (!n.read) { %>
            <button class="mark-read-btn action-btn" data-id="<%= n._id %>" style="padding: 6px 10px; font-size: 0.7rem;">Read</button>
          <% } %>
        </div>
      <% }) %>
    </div>
  </main>
  <%- include('partials/right-sidebar') %>
</div>
<%- include('partials/footer') %>
