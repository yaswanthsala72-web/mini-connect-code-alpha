<%- include('partials/header') %>
<div class="app-container">
  <%- include('partials/sidebar') %>
  <main class="main-feed">
    <div class="glass-panel" style="padding: 20px; margin-bottom: 24px;">
      <h1 style="font-weight: 800; font-size: 1.4rem;">Saved Posts</h1>
      <p style="color: var(--text-secondary); font-size: 0.85rem; margin-top: 6px;">Your bookmarked creations</p>
    </div>
    <div style="display: flex; flex-direction: column; gap: 24px;">
      <% if (posts.length === 0) { %>
        <div class="glass-panel" style="padding: 50px; text-align: center;">
          <p style="color: var(--text-secondary);">No saved posts yet. Tap the bookmark icon on any post.</p>
        </div>
      <% } %>
      <% posts.forEach(post => { %>
        <%- include('partials/post-card', { post, currentUser, savedPostIds }) %>
      <% }) %>
    </div>
  </main>
  <%- include('partials/right-sidebar') %>
</div>
<%- include('partials/footer') %>
